<Project>
  <!-- On iOS a native library has to be a framework embedded in the app. The other platforms find theirs
       under runtimes/ with no help. -->
  <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'ios'">
    <NativeReference Include="$(MSBuildThisFileDirectory)..\native\ios\speechwarp_listen.xcframework" Kind="Framework" />
  </ItemGroup>
</Project>
